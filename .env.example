# Agent Pitch — environment template.
# Copy this file to `.env` (same directory as docker-compose.yml) and fill in
# real values. `.env` is gitignored; `.env.example` is committed as a template.
#
#   cp .env.example .env
#   # then edit .env and set a strong password
#
# docker-compose.yml passes AGENTPITCH_ADMIN_PASSWORD through to the container.

# First-run admin password. Only used when NO users exist yet (fresh data dir).
# If left unset, the server generates a one-time password and prints it to the
# container log. The admin is always forced to change it on first login.
AGENTPITCH_ADMIN_PASSWORD=change-me-to-a-strong-password
