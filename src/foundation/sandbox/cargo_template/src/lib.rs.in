// agent-pitch Rust strategy reference template (ADR-0026).
//
// The runtime ABI below is REQUIRED. The host (WasmtimeSandbox) calls these
// exports each tick:
//
//   alloc_buf(len)           -> ptr            // host allocates input buffer
//   decide(ptr, len)         -> i32 status     // 0=ok, non-zero=error
//   return_ptr() / return_len()                // pull serialized Action out
//   dealloc_buf(ptr, len)                      // host frees buffers
//
// The `decide_logic(...)` function below is the only part you (or the LLM)
// should edit. Rebuild by replacing the call site, then re-running the host.
//
// Output Action MUST be serialized via `rmp_serde::to_vec_named` so Python's
// msgpack decodes structs as maps (not arrays). Required by the host
// (`Action.from_tagged` expects `{"type": ...}` dicts).

use serde::{Deserialize, Serialize};
use std::alloc::{alloc, dealloc, Layout};

// ── Game state schema (read by `decide_logic`) ────────────────────────────

#[derive(Deserialize)]
struct GameState {
    tick: u32,
    ball: Ball,
    field: Field,
    my_team: String,
    my_player_id: String,
}

#[derive(Deserialize)]
struct Ball {
    position: (f64, f64),
    carrier_id: Option<String>,
}

#[derive(Deserialize)]
struct Field {
    width: f64,
    height: f64,
    team_a_goal_x: f64,
    team_b_goal_x: f64,
}

#[derive(Deserialize)]
struct PlayerState {
    role: String,
    position: (f64, f64),
    has_ball: bool,
    speed: i32,
}

#[derive(Deserialize)]
struct TickRecord {
    tick: u32,
}

#[derive(Serialize)]
#[serde(tag = "type")]
enum Action {
    Move { dx: f64, dy: f64, speed: f64 },
    Pass { target_pos: (f64, f64), power: i32 },
    Shoot { angle: f64, power: i32 },
    Tackle { target_player_id: String },
    Hold,
}

// ── Host-injected, seeded RNG (deterministic per-player) ──────────────────

#[link(wasm_import_module = "host")]
extern "C" {
    fn random_u64() -> u64;
}

// ── EDIT BELOW: your strategy logic ───────────────────────────────────────

fn decide_logic(gs: &GameState, ps: &PlayerState, _hist: &[TickRecord]) -> Action {
    if ps.has_ball {
        return Action::Hold;
    }
    let (bx, by) = gs.ball.position;
    let (mx, my) = ps.position;
    let dx = bx - mx;
    let dy = by - my;
    let mag = (dx * dx + dy * dy).sqrt();
    let (ndx, ndy) = if mag > 0.001 { (dx / mag, dy / mag) } else { (1.0, 0.0) };
    Action::Move { dx: ndx, dy: ndy, speed: 1.0 }
}

// ── DO NOT EDIT BELOW: ABI surface required by WasmtimeSandbox ───────────

static mut RETURN_PTR: i32 = 0;
static mut RETURN_LEN: i32 = 0;

#[no_mangle]
pub extern "C" fn alloc_buf(size: usize) -> *mut u8 {
    let layout = Layout::from_size_align(size.max(1), 8).unwrap();
    unsafe { alloc(layout) }
}

#[no_mangle]
pub extern "C" fn dealloc_buf(ptr: *mut u8, size: usize) {
    let layout = Layout::from_size_align(size.max(1), 8).unwrap();
    unsafe { dealloc(ptr, layout) };
}

#[no_mangle]
pub extern "C" fn return_ptr() -> i32 {
    unsafe { RETURN_PTR }
}

#[no_mangle]
pub extern "C" fn return_len() -> i32 {
    unsafe { RETURN_LEN }
}

#[no_mangle]
pub extern "C" fn decide(ptr: *const u8, len: usize) -> i32 {
    let bytes = unsafe { std::slice::from_raw_parts(ptr, len) };
    let (gs, ps, hist): (GameState, PlayerState, Vec<TickRecord>) =
        match rmp_serde::from_slice(bytes) {
            Ok(v) => v,
            Err(_) => return -1,
        };

    let action = decide_logic(&gs, &ps, &hist);

    let out = match rmp_serde::to_vec_named(&action) {
        Ok(v) => v,
        Err(_) => return -1,
    };
    let out_ptr = alloc_buf(out.len());
    unsafe {
        std::ptr::copy_nonoverlapping(out.as_ptr(), out_ptr, out.len());
        RETURN_PTR = out_ptr as i32;
        RETURN_LEN = out.len() as i32;
    }
    0
}
