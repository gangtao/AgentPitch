=== SECTION 6: FEW-SHOT SKELETON ===
function decide(game_state, player_state, history) {
    if (player_state.has_ball) {
        if (player_state.role === "FWD") {
            return {type: "Shoot", angle: 0.0, power: 15};
        }
        return {type: "Pass", target_pos: [80.0, 30.0], power: 12};
    }
    return {type: "Move", dx: 1.0, dy: 0.0, speed: 1.0};
}

